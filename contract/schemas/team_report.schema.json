{
  "$id": "team_report.schema.json",
  "title": "One team's tendencies: deviations from a baseline, each with an interval and a sample size",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "team_id",
    "data_kind",
    "as_of_utc",
    "n_games",
    "n_possessions",
    "n_candidates",
    "method",
    "interval_level",
    "sort",
    "tendencies"
  ],
  "properties": {
    "team_id": {
      "type": "integer"
    },
    "data_kind": {
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "as_of_utc": {
      "type": "string"
    },
    "n_games": {
      "type": "integer",
      "minimum": 0
    },
    "n_possessions": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "final"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        }
      }
    },
    "interval_level": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 0.999
    },
    "sort": {
      "const": "rank_score_desc"
    },
    "tendencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "player_id",
          "situation",
          "outcome",
          "baseline_kind",
          "baseline_rate",
          "raw_rate",
          "shrunk_rate",
          "deviation",
          "interval",
          "n",
          "k",
          "prior_strength",
          "rank_score",
          "excludes_zero"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "team",
              "player"
            ]
          },
          "player_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "situation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "head",
              "class",
              "label"
            ],
            "properties": {
              "head": {
                "enum": [
                  "finisher",
                  "ending_type",
                  "shot_family",
                  "action_style",
                  "creation",
                  "tempo",
                  "fast_break"
                ]
              },
              "class": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          },
          "baseline_kind": {
            "enum": [
              "league_same_situation",
              "team_overall_plus_league_shift",
              "player_overall",
              "team_elsewhere_plus_league_shift",
              "player_lineup_adjusted"
            ]
          },
          "baseline_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "raw_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "shrunk_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "deviation": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "k": {
            "type": "integer",
            "minimum": 0
          },
          "prior_strength": {
            "type": "number",
            "minimum": 0
          },
          "rank_score": {
            "type": "number"
          },
          "excludes_zero": {
            "type": "boolean"
          },
          "prob_beyond": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "n_candidates": {
      "type": "integer",
      "minimum": 0
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drift_included": {
      "type": "boolean"
    },
    "coach_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "interval_level",
        "season",
        "timeouts",
        "foul_trouble",
        "closing"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "interval_level": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.999
        },
        "season": {
          "type": "integer"
        },
        "timeouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_row"
          }
        },
        "foul_trouble": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_row"
          }
        },
        "closing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n_close_games",
            "close_margin",
            "window_s",
            "players"
          ],
          "properties": {
            "n_close_games": {
              "type": "integer",
              "minimum": 0
            },
            "close_margin": {
              "type": "integer",
              "minimum": 0
            },
            "window_s": {
              "type": "number",
              "minimum": 0
            },
            "players": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "player_id",
                  "n",
                  "k",
                  "rate",
                  "interval"
                ],
                "properties": {
                  "player_id": {
                    "type": "integer"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "interval": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "defense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "baseline",
        "interval_level",
        "threshold",
        "drift_included",
        "season",
        "n_games",
        "n_possessions",
        "rows"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "interval_level": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.999
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drift_included": {
          "type": "boolean"
        },
        "season": {
          "type": "integer"
        },
        "n_games": {
          "type": "integer",
          "minimum": 0
        },
        "n_possessions": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defense_row"
          }
        }
      }
    }
  },
  "$defs": {
    "decision_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "n",
        "k",
        "raw_rate",
        "rate",
        "interval",
        "league_rate",
        "league_n",
        "prior_strength"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "raw_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "league_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "league_n": {
          "type": "integer",
          "minimum": 0
        },
        "prior_strength": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "defense_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "expected_rate",
        "raw_rate",
        "shrunk_rate",
        "deviation",
        "interval",
        "n",
        "k",
        "prob_beyond",
        "excludes_zero"
      ],
      "properties": {
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "class",
            "label"
          ],
          "properties": {
            "head": {
              "enum": [
                "shot_family",
                "ending_type"
              ]
            },
            "class": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "expected_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shrunk_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deviation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "prob_beyond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "excludes_zero": {
          "type": "boolean"
        }
      }
    }
  }
}

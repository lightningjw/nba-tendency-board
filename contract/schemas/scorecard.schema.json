{
  "$id": "scorecard.schema.json",
  "title": "Each head's log-loss and calibration against its baseline: retrospectively on held-out games and a held-out season, and prospectively on games logged before tip-off",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_kind",
    "generated_at",
    "interval_level",
    "bootstrap",
    "heads"
  ],
  "properties": {
    "data_kind": {
      "enum": [
        "synthetic",
        "real"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "interval_level": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 0.999
    },
    "bootstrap": {
      "type": "string"
    },
    "heads": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "head",
          "splits"
        ],
        "properties": {
          "head": {
            "enum": [
              "finisher",
              "ending_type",
              "shot_family",
              "action_style",
              "tempo",
              "timeout",
              "foul_sub",
              "closing_five"
            ]
          },
          "splits": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "split",
                "available",
                "reason",
                "n_possessions",
                "n_games",
                "model",
                "baseline",
                "delta",
                "verdict",
                "top1",
                "reliability"
              ],
              "properties": {
                "split": {
                  "enum": [
                    "holdout_games",
                    "holdout_season"
                  ]
                },
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "n_possessions": {
                  "type": "integer",
                  "minimum": 0
                },
                "n_games": {
                  "type": "integer",
                  "minimum": 0
                },
                "model": {
                  "$ref": "#/$defs/metric"
                },
                "baseline": {
                  "$ref": "#/$defs/metric"
                },
                "delta": {
                  "$ref": "#/$defs/metric"
                },
                "verdict": {
                  "enum": [
                    "model_better",
                    "baseline_better",
                    "inconclusive",
                    null
                  ]
                },
                "top1": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "model",
                    "baseline",
                    "n"
                  ],
                  "properties": {
                    "model": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "baseline": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "reliability": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "model",
                    "baseline"
                  ],
                  "properties": {
                    "model": {
                      "$ref": "#/$defs/reliability"
                    },
                    "baseline": {
                      "$ref": "#/$defs/reliability"
                    }
                  }
                }
              }
            }
          },
          "model_id": {
            "type": "string"
          },
          "challengers": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_id",
                "replaces_primary",
                "splits"
              ],
              "properties": {
                "model_id": {
                  "type": "string"
                },
                "replaces_primary": {
                  "type": "boolean"
                },
                "splits": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "split",
                      "available",
                      "reason",
                      "n_possessions",
                      "n_games",
                      "model",
                      "vs_baseline",
                      "vs_primary",
                      "verdict",
                      "top1",
                      "ece"
                    ],
                    "properties": {
                      "split": {
                        "enum": [
                          "holdout_games",
                          "holdout_season"
                        ]
                      },
                      "available": {
                        "type": "boolean"
                      },
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "n_possessions": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "n_games": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "model": {
                        "$ref": "#/$defs/metric"
                      },
                      "vs_baseline": {
                        "$ref": "#/$defs/metric"
                      },
                      "vs_primary": {
                        "$ref": "#/$defs/metric"
                      },
                      "verdict": {
                        "enum": [
                          "ahead",
                          "level",
                          "behind",
                          null
                        ]
                      },
                      "top1": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "ece": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      }
                    }
                  }
                },
                "second_seed": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "split",
                      "vs_primary",
                      "verdict"
                    ],
                    "properties": {
                      "split": {
                        "enum": [
                          "holdout_games",
                          "holdout_season"
                        ]
                      },
                      "vs_primary": {
                        "$ref": "#/$defs/metric"
                      },
                      "verdict": {
                        "enum": [
                          "ahead",
                          "level",
                          "behind",
                          null
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "prospective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "mode",
        "reason",
        "n_dates",
        "n_games",
        "n_late",
        "first_date",
        "last_date",
        "models",
        "heads"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "live",
            "replay",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "n_dates": {
          "type": "integer",
          "minimum": 0
        },
        "n_games": {
          "type": "integer",
          "minimum": 0
        },
        "n_late": {
          "type": "integer",
          "minimum": 0
        },
        "first_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "trained_through",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "trained_through": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "heads": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "head",
              "result"
            ],
            "properties": {
              "head": {
                "enum": [
                  "finisher",
                  "ending_type",
                  "shot_family"
                ]
              },
              "result": {
                "$ref": "#/$defs/prospective_result"
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "label",
          "experimental",
          "note",
          "fit"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "experimental": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "fit": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "chosen",
              "selection",
              "hardware",
              "seconds",
              "n_train_games",
              "n_parameters",
              "configs"
            ],
            "properties": {
              "chosen": {
                "type": "string"
              },
              "selection": {
                "type": "string"
              },
              "hardware": {
                "type": "string"
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "n_train_games": {
                "type": "integer",
                "minimum": 0
              },
              "n_parameters": {
                "type": "integer",
                "minimum": 0
              },
              "configs": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "d_model",
                    "n_layers",
                    "history",
                    "epochs",
                    "n_parameters",
                    "seconds",
                    "valid_loss",
                    "chosen"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "d_model": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "n_layers": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "history": {
                      "type": "boolean"
                    },
                    "epochs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "n_parameters": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "valid_loss": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "chosen": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "seeds": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "maxItems": 4
              },
              "second_seed_valid_loss": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "log_loss",
        "interval"
      ],
      "properties": {
        "log_loss": {
          "type": "number"
        },
        "interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ece",
        "bins"
      ],
      "properties": {
        "ece": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lo",
              "hi",
              "n",
              "mean_pred",
              "obs_rate"
            ],
            "properties": {
              "lo": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hi": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "mean_pred": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "obs_rate": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "prospective_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split",
        "available",
        "reason",
        "n_possessions",
        "n_games",
        "model",
        "baseline",
        "delta",
        "verdict",
        "top1",
        "reliability"
      ],
      "properties": {
        "split": {
          "enum": [
            "prospective"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "n_possessions": {
          "type": "integer",
          "minimum": 0
        },
        "n_games": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "$ref": "#/$defs/metric"
        },
        "baseline": {
          "$ref": "#/$defs/metric"
        },
        "delta": {
          "$ref": "#/$defs/metric"
        },
        "verdict": {
          "enum": [
            "model_better",
            "baseline_better",
            "inconclusive",
            null
          ]
        },
        "top1": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "model",
            "baseline",
            "n"
          ],
          "properties": {
            "model": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "baseline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reliability": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "model",
            "baseline"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/reliability"
            },
            "baseline": {
              "$ref": "#/$defs/reliability"
            }
          }
        }
      }
    }
  }
}
